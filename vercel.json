{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["fra1"],
  "rewrites": [
    { "source": "/api/hr.xlsx", "destination": "/api/hr" }
  ],
  "functions": {
    "api/compare.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
    },
    "api/hr.js": {
      "maxDuration": 30
    }
  }
}
